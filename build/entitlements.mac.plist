<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
  <dict>
    <!-- Electron needs JIT compilation for its JavaScript engine -->
    <key>com.apple.security.cs.allow-jit</key>
    <true/>
    <!-- Electron renderer process needs unsigned executable memory -->
    <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
    <true/>
    <!-- Required for node-llama-cpp and nodejs-whisper native .dylib loading -->
    <key>com.apple.security.cs.disable-library-validation</key>
    <true/>
    <!-- Microphone access for voice dictation (STT feature) -->
    <key>com.apple.security.device.microphone</key>
    <true/>
  </dict>
</plist>
